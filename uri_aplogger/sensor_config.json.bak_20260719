{
  "logging": {
    "verbosity": 4,
    "console": true,
    "file": false
  },
  "sensors": {
    "imet": {
      "type": "iMet",
      "script": "sensor_runner.py",
      "enabled": true,
      "restart_delay": 5,
      "startup_delay": 2,
      "identifiers": {
        "vendor_id": "0403",
        "model_id": "6015",
        "serial_short": "D30D1A75"
      },
      "baudrate": 57600,
      "timeout": 2,
      "column_names": ["Timestamp", "pressure", "temp", "rel_hum", "hum_temp", "date", "time", "longitude", "latitude", "altitude", "sat"]
    },
    "pom": {
      "type": "POM",
      "script": "sensor_runner.py", 
      "enabled": true,
      "restart_delay": 5,
      "startup_delay": 2,
      "identifiers": {
        "vendor_id": "067b",
        "model_id": "23a3"
      },
      "baudrate": 19200,
      "timeout": 1,
      "column_names": ["Timestamp", "Ozone_ppb", "Cell_Temperature_K", "Cell_Pressure_torr", "Photodiode_Voltage_V", "Power_Supply_V", "Latitude", "Longitude", "Altitude_m", "GPS_Quality", "Date", "Time"]
    },
    "trisonica": {
      "type": "TriSonica",
      "script": "sensor_runner.py",
      "enabled": false,
      "restart_delay": 5,
      "startup_delay": 2,
      "identifiers": {
        "vendor_id": "10c4",
        "model_id": "ea60"
      },
      "baudrate": 115200,
      "timeout": 1,
      "column_names": ["Timestamp", "Wind_Speed", "Wind_Direction", "U_Vector", "V_Vector", "W_Vector", "Temperature", "Relative_Humidity", "Pressure", "Compass_Heading", "Pitch", "Roll"]
    },
    "spectro": {
      "type": "spectrometer",
      "script": "spectro.py",
      "enabled": true,
      "restart_delay": 5,
      "startup_delay": 2,
      "output_file_pattern": "output/spectro/spectro_summary_*.csv",
      "column_names": ["Timestamp", "peak_wavelength", "max_intensity", "mean_intensity", "std_intensity", "total_points", "status"]
    },
    "partector2pro": {
      "type": "Partector2Pro",
      "script": "sensor_runner.py",
      "enabled": true,
      "restart_delay": 5,
      "startup_delay": 3,
      "identifiers": {
        "vendor_id": "ffff",
        "model_id": "0005"
      },
      "mode": 6,
      "baudrate": 115200,
      "timeout": 2,
    "column_names": ["Timestamp","time_since_start_s","number_cm3","diameter_nm","ldsa_um2_cm3","total_surface_um2_cm3","mass_ug_m3","gsd",
    "charger_current_nA","charger_hv_V","precipitator_voltage_V","temperature_C","rh_percent","pressure_mbar","flow_lpm","battery_V","pump_current_mA","status","internal_value","solution_steps",
    "bin1_dN_dlogD","bin2_dN_dlogD","bin3_dN_dlogD","bin4_dN_dlogD","bin5_dN_dlogD","bin6_dN_dlogD","bin7_dN_dlogD","bin8_dN_dlogD","em_amp1_mV","em_amp2_mV","em_amp3_mV","em_amp4_mV","em_amp5_mV"]    
    },
    "miniaeth": {
      "type": "MiniaethMA200",
      "script": "sensor_runner.py",
      "enabled": false,

      "identifiers": { "vendor_id": "0403", "model_id": "6001" },
      "baudrate": 1000000,
      "timeout": 1,
      "poll_interval": 1.0,

      "logging": { "verbosity": 3, "console": true, "file": true },
      "column_names": ["Timestamp", "accel_x", "accel_y", "accel_z", "battery", "blue_ATN1", "blue_ATN2", "blue_BC1", "blue_BC2", "blue_BCc", "blue_K", "blue_ref", "blue_sen1", "blue_sen2", "datum_id", "flow1", "flow2", "flow_setpoint", "flow_total", "gps_lat", "gps_long", "gps_speed", "green_ATN1", "green_ATN2", "green_BC1", "green_BC2", "green_BCc", "green_K", "green_ref", "green_sen1", "green_sen2", "int_pressure", "int_temp", "IR_ATN1", "IR_ATN2","IR_BC1", "IR_BC2", "IR_BCc", "IR_K", "IR_ref", "IR_sen1", "IR_sen2", "red_ATN1", "red_ATN2", "red_BC1", "red_BC2", "red_BCc", "red_K", "red_ref", "red_sen1", "red_sen2", "sample_dewpoint", "sample_RH", "sample_temp", "status","tape_pos", "timebase", "timezone_offset", "UV_ATN1", "UV_ATN2", "UV_BC1", "UV_BC2", "UV_BCc", "UV_K", "UV_ref", "UV_sen1", "UV_sen2", "date_time_GMT"]
    },
    "pops": {
      "type": "POPS",
      "script": "sensor_runner.py",
      "enabled": false,
      "startup_delay": 2,
      "restart_delay": 5,

      "udp_ip": "0.0.0.0",
      "udp_port": 10080,
      "buffer_size": 4096,

      "column_names": [
        "Timestamp",
        "DateTime","TimeSSM","Status","DataStatus","PartCt","HistSum","PartCon","BL","BLTH","STD","MaxSTD","P","TofP",
        "PumpLife_hrs","WidthSTD","AveWidth","POPS_Flow","PumpFB","LDTemp","LaserFB","LD_Mon","Temp","BatV","Laser_Curent",
        "Flow_Set","BL_Start","TH_Mult","nbins","logmin","logmax","Skip_Save","MinPeakPts","MaxPeakPts","RawPts",
        "b0","b1","b2","b3","b4","b5","b6","b7","b8","b9","b10","b11","b12","b13","b14","b15"
      ]
    },

    "ldd": {
      "type": "LDD_USB",
      "script": "sensor_runner.py",
      "enabled": true,
      "startup_delay": 2,
      "restart_delay": 5,

      "identifiers": {
        "vendor_id": "0403",
        "model_id": "6015",
        "serial_short": "DQ01F1MH"
      },

      "baudrate": 57600,
      "timeout": 1,
      "poll_interval": 1.0,

      "column_names": [
        "Timestamp",
        "ErrorNumber","ErrorInstance","ErrorParameter",
        "LDD_ActualOutputCurrent","LDD_ActualOutputVoltage","LDD_ActualOutputCurrentRaw",
        "LDD_ActualAnodeVoltage","LDD_ActualCathodeVoltage",
        "LDD_NominalOutputCurrentRamp",
        "TEC_TargetObjectTemperature","TEC_NominalObjectTemperatureRamp","TEC_ThermalPowerModelCurrent",
        "TEC_ActualOutputCurrent","TEC_ActualOutputVoltage",
        "TEC_ObjectTemperature","TEC_SinkTemperature",
        "AnalogVoltageInputRawADC","AnalogVoltageInput",
        "LaserPower","OutputLevel",
        "DriverInputVoltage","Internal8V","Internal5V"
      ]
    },
    "pump": {
      "type": "Pump",
      "script": "sensor_runner.py",
      "enabled": false,
      "identifiers": { "vendor_id": "2341", "model_id": "0058", "serial_short": "C95C97095154513747202020FF192D24"},
      "baudrate": 115200,
      "timeout": 1,
      
      "initial_power": 40.0,
      "power_fifo": "output/pump/power.fifo",
      "column_names": [ "Timestamp","rpm","pressure_mb","temp_c","humidity_pct", "target_speed"]
    },
    "cavity": {
      "type": "Cavity",
      "script": "sensor_runner.py",
      "enabled": true,
      "startup_delay": 2,
      "restart_delay": 5,

      "identifiers": {
        "vendor_id": "2341",
        "model_id": "0058"
      },

      "baudrate": 115200,
      "timeout": 1,

      "expect_ms_field": true,

      "column_names": [
        "Timestamp",
        "ms",
        "ErrorNumber","ErrorInstance","ErrorParameter","ErrorText",
        "LDD_ActualOutputCurrent","LDD_ActualOutputVoltage","LDD_ActualOutputCurrentRaw",
        "LDD_ActualAnodeVoltage","LDD_ActualCathodeVoltage",
        "LDD_NominalOutputCurrentRamp",
        "TEC_TargetObjectTemperature","TEC_NominalObjectTemperatureRamp","TEC_ThermalPowerModelCurrent",
        "TEC_ActualOutputCurrent","TEC_ActualOutputVoltage",
        "TEC_ObjectTemperature","TEC_SinkTemperature",
        "AnalogVoltageInputRawADC","AnalogVoltageInput",
        "LaserPower","OutputLevel",
        "DriverInputVoltage","Internal8V","Internal5V","Internal3V3","InternalMinus3V3",
        "DeviceTemperature","PowerstageTemperature",
        "pump_rpm","pressure_mb","temp_c","humidity_pct","power_pct","pressure_status", "target_speed"
      ]
    }
  },
  "merger": {
    "script": "real_time_merger.py",
    "enabled": true,
    "startup_delay": 5
  },
  "vitals": {
    "enabled": true,
    "script": "vitals.py",
    "interval": 1.0,
    "startup_delay": 12
},
  "path": "/home/rsp/drone_air_system/uri_aplogger/"
  
}